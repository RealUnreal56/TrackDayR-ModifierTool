<Window x:Class="ModifierTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier Tool"
        Width="1000"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0C">

    <Window.Resources>

        <!-- ========================================= -->
        <!-- COLORS -->
        <!-- ========================================= -->

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#0B0B0C"/>

        <SolidColorBrush x:Key="PanelBrush"
                         Color="#141416"/>

        <SolidColorBrush x:Key="InputBrush"
                         Color="#1B1B1E"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#303035"/>

        <SolidColorBrush x:Key="YellowBrush"
                         Color="#FFD21C"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F2F2F2"/>

        <SolidColorBrush x:Key="SubTextBrush"
                         Color="#858589"/>


        <!-- ========================================= -->
        <!-- BUTTON STYLE -->
        <!-- ========================================= -->

        <Style x:Key="YellowButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="{StaticResource YellowBrush}"/>

            <Setter Property="Foreground"
                    Value="#0B0B0C"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="Bold"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="20,0">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#FFE05A"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#DDB600"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ========================================= -->
        <!-- INPUT STYLE -->
        <!-- ========================================= -->

        <Style x:Key="FileInput"
               TargetType="TextBox">

            <Setter Property="Background"
                    Value="{StaticResource InputBrush}"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource YellowBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1.5"/>

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="Height"
                    Value="52"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="CaretBrush"
                    Value="{StaticResource YellowBrush}"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="TextBox">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <!-- ============================================= -->
    <!-- MAIN -->
    <!-- ============================================= -->

    <Grid>

        <!-- Background -->
        <Border
            Background="{StaticResource BackgroundBrush}"/>


        <!-- Center Panel -->
        <Border
            Width="560"
            Padding="45"
            Background="{StaticResource PanelBrush}"
            CornerRadius="14"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <Border.Effect>

                <DropShadowEffect
                    BlurRadius="35"
                    ShadowDepth="0"
                    Opacity="0.45"/>

            </Border.Effect>


            <StackPanel>
                <!-- ================================= -->
                <!-- TITLE -->
                <!-- ================================= -->

                <TextBlock
                    Text="MODIFIER TOOL"
                    Foreground="{StaticResource YellowBrush}"
                    FontSize="36"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"/>


                <!-- ================================= -->
                <!-- SUBTITLE -->
                <!-- ================================= -->

                <TextBlock
                    Text="Select your mod folder to continue"
                    Foreground="{StaticResource SubTextBrush}"
                    FontSize="14"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,38"/>


                <!-- ================================= -->
                <!-- FILE INPUT -->
                <!-- ================================= -->

                <TextBlock
                    Text="MOD FOLDER"
                    Foreground="{StaticResource SubTextBrush}"
                    FontSize="11"
                    FontWeight="Bold"
                    Margin="2,0,0,8"/>


                <TextBox
                    x:Name="FilePathTextBox"
                    Style="{StaticResource FileInput}"
                    Text=""
                    ToolTip="Path to your TrackDayR mod folder"/>


                <!-- ================================= -->
                <!-- BROWSE -->
                <!-- ================================= -->

                <Button
                    Content="BROWSE"
                    Click="BrowseButton_Click"
                    Style="{StaticResource YellowButton}"
                    Height="48"
                    Margin="0,14,0,30"/>


                <!-- ================================= -->
                <!-- DIVIDER -->
                <!-- ================================= -->

                <Border
                    Height="1"
                    Background="{StaticResource BorderBrush}"
                    Margin="0,0,0,25"/>


                <!-- ================================= -->
                <!-- NEXT -->
                <!-- ================================= -->

                <Button
                    Content="NEXT  →"
                    Click="NextButton_Click"
                    Style="{StaticResource YellowButton}"
                    Height="52"/>

            </StackPanel>

        </Border>

    </Grid>

</Window>