<Window x:Class="ModifierTool.ModifyBikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier Tool"
        Width="1200"
        Height="750"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0B0B0C">

    <Window.Resources>

        <!-- Brushes -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0B0C"/>
        <SolidColorBrush x:Key="TopBarBrush" Color="#101011"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#161617"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#29292B"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#FFD21C"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#77777A"/>

        <!-- Top Bar Button -->
        <Style x:Key="TopBarButton" TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource GoldBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Mouse over -->
                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#1C1C1E"/>

                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background"
                                    Value="#FFD21C"/>

                                <Setter
                                    Property="Foreground"
                                    Value="#0B0B0C"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>


    <Grid Background="{StaticResource BackgroundBrush}">

        <Grid.RowDefinitions>

            <!-- Top Bar -->
            <RowDefinition Height="70"/>

            <!-- Content -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ========================= -->
        <!-- TOP BAR -->
        <!-- ========================= -->

        <Border
            Grid.Row="0"
            Background="{StaticResource TopBarBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- Title -->
                    <ColumnDefinition Width="*"/>

                    <!-- Buttons -->
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- BACK + TITLE -->

                <StackPanel
                    Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="15,0,0,0">

                    <Button
                        x:Name="BackButton"
                        Content="← BACK"
                        Style="{StaticResource TopBarButton}"
                        Height="40"
                        Click="BackButton_Click"
                        Margin="0,0,15,0"/>

                    <StackPanel
                        Orientation="Vertical"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="MODIFY BIKE"
                            Foreground="{StaticResource GoldBrush}"
                            FontSize="11"
                            FontWeight="Bold"/>

                        <TextBlock
                            x:Name="BikeNameText"
                            Text="BIKE"
                            Foreground="{StaticResource TextBrush}"
                            FontSize="20"
                            FontWeight="Bold"
                            Margin="0,2,0,0"/>

                    </StackPanel>

                </StackPanel>


                <!-- MENU BUTTONS -->

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0">

                    <Button
                        x:Name="EngineButton"
                        Content="ENGINE"
                        Style="{StaticResource TopBarButton}"
                        Height="40"
                        Click="EngineButton_Click"/>

                    <Button
                        x:Name="GearboxButton"
                        Content="GEARBOX"
                        Style="{StaticResource TopBarButton}"
                        Height="40"
                        Click="GearboxButton_Click"/>

                    <Button
                        x:Name="WeightButton"
                        Content="OTHER"
                        Style="{StaticResource TopBarButton}"
                        Height="40"
                        Click="OtherButton_Click"/>

                    <Button
                        x:Name="ModificationButton"
                        Content="LOAD / SAVE"
                        Style="{StaticResource TopBarButton}"
                        Height="40"
                        Click="ModificationButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================= -->
        <!-- CONTENT -->
        <!-- ========================= -->

        <Border
            Grid.Row="1"
            Margin="15"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel
                    x:Name="ContentPanel"
                    Margin="20">

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>